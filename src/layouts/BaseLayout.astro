---
/** BaseLayout.astro — base page wrapper */
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noIndex?: boolean;
}

const { title, description, ogImage, noIndex } = Astro.props;
const siteTitle = 'LoveYX';
const fullTitle = title === siteTitle ? title : `${title} — ${siteTitle}`;
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={description || 'LoveYX — 探索技术前沿，记录创造历程'} />
  {noIndex && <meta name="robots" content="noindex" />}
  <!-- Favicon -->
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#f8a5c2" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description || 'LoveYX — 探索技术前沿，记录创造历程'} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="LoveYX" />
  <meta property="og:image" content={ogImage || 'https://loveyx.fun/android-chrome-512x512.png'} />
  <link rel="sitemap" href="/sitemap-index.xml" />
</head>
<body class="min-h-screen flex flex-col">
  <Header />
  <main class="flex-1 pt-14">
    <slot />
  </main>
  <Footer />
</body>
</html>
