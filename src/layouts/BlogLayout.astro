---
/** BlogLayout.astro — article detail layout */
import BaseLayout from './BaseLayout.astro';
import TOC from '../components/TOC.astro';
import type { CollectionEntry } from 'astro:content';

export interface Props {
  entry: CollectionEntry<'blog'>;
  prevEntry?: { slug: string; title: string } | null;
  nextEntry?: { slug: string; title: string } | null;
}

const { entry, prevEntry, nextEntry } = Astro.props;
const { title, description, date, tags = [], category, cover, readingTime } = entry.data;
const displayDate = new Date(date).toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });

const headings = entry.data.headings as { depth: number; text: string; slug: string }[] | undefined;
---

<BaseLayout title={title} description={description} ogImage={cover}>
  <div class="flex justify-center px-5">
    <div class="w-full max-w-[728px] pt-10 pb-20">
      <!-- Article Header -->
      <header class="mb-10">
        {category && (
          <a href={`/categories/${encodeURIComponent(category)}`}
             class="inline-flex items-center gap-1.5 mb-4 px-2.5 py-1 rounded-full text-xs font-medium
                    transition-colors duration-300 hover:no-underline"
             style="color: var(--color-accent); background: color-mix(in srgb, var(--color-accent) 8%, transparent);">
            <span class="w-1 h-1 rounded-full bg-[var(--color-accent)]"></span>{category}
          </a>
        )}
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold tracking-tight leading-tight" style="color: var(--color-text)">{title}</h1>
        {description && (
          <p class="mt-4 text-base leading-relaxed" style="color: var(--color-muted)">{description}</p>
        )}
        <div class="mt-6 flex flex-wrap items-center gap-4 text-sm" style="color: var(--color-muted)">
          <div class="flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 opacity-50" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            <time datetime={date}>{displayDate}</time>
          </div>
          {readingTime && (
            <div class="flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 opacity-50" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              <span>{readingTime}</span>
            </div>
          )}
        </div>
        {tags.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-1.5">
            {tags.map((tag: string) => (
              <a href={`/tags/${encodeURIComponent(tag)}`}
                 class="text-xs rounded-md px-2 py-0.5 transition-colors hover:no-underline"
                 style="color: var(--color-muted); background: var(--color-surface); border: 1px solid var(--color-border);">#{tag}</a>
            ))}
          </div>
        )}
      </header>

      <div class="flex gap-10">
        <!-- Article body -->
        <div class="flex-1 min-w-0">
          {cover && (
            <img src={cover} alt={title}
                 class="rounded-2xl w-full mb-10 shadow-lg" style="border: 1px solid var(--color-border);" loading="eager"/>
          )}
          <article class="prose prose-base sm:prose-lg max-w-none
                          prose-headings:text-[var(--color-text)]
                          prose-p:text-[var(--color-text)]/90 prose-p:leading-relaxed
                          prose-a:text-accent prose-a:no-underline hover:prose-a:underline
                          prose-code:before:content-none prose-code:after:content-none
                          prose-strong:text-[var(--color-text)]
                          prose-li:text-[var(--color-text)]/90
                          prose-blockquote:border-l-accent prose-blockquote:bg-[var(--color-surface)]
                          prose-blockquote:rounded-r-lg prose-blockquote:py-1 prose-blockquote:px-4
                          prose-blockquote:text-[var(--color-muted)]
                          prose-hr:border-[var(--color-border)]
                          prose-img:rounded-xl prose-img:shadow-md">
            <slot />
          </article>

          <!-- Prev / Next -->
          {(prevEntry || nextEntry) && (
            <nav class="mt-14 grid grid-cols-1 sm:grid-cols-2 gap-4">
              {prevEntry && (
                <a href={`/blog/${prevEntry.slug}`}
                   class="flex items-start gap-3 rounded-xl p-4 border transition-all duration-300
                          hover:-translate-y-0.5 hover:shadow-lg hover:border-accent/[0.15] hover:no-underline"
                   style="background: var(--color-surface); border-color: var(--color-border);">
                  <svg class="w-4 h-4 mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="color: var(--color-muted)"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
                  <div>
                    <div class="text-xs" style="color: var(--color-muted)">上一篇</div>
                    <div class="text-sm font-medium line-clamp-1 mt-1 transition-colors duration-300 hover:text-accent" style="color: var(--color-text)">{prevEntry.title}</div>
                  </div>
                </a>
              )}
              {nextEntry && (
                <a href={`/blog/${nextEntry.slug}`}
                   class="flex items-start justify-end gap-3 rounded-xl p-4 border transition-all duration-300 sm:text-right
                          hover:-translate-y-0.5 hover:shadow-lg hover:border-accent/[0.15] hover:no-underline sm:col-start-2"
                   style="background: var(--color-surface); border-color: var(--color-border);">
                  <div>
                    <div class="text-xs" style="color: var(--color-muted)">下一篇</div>
                    <div class="text-sm font-medium line-clamp-1 mt-1 transition-colors duration-300 hover:text-accent" style="color: var(--color-text)">{nextEntry.title}</div>
                  </div>
                  <svg class="w-4 h-4 mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="color: var(--color-muted)"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                </a>
              )}
            </nav>
          )}
        </div>

        <!-- Sidebar TOC -->
        {headings && headings.length > 0 && <TOC headings={headings} />}
      </div>
    </div>
  </div>
</BaseLayout>
