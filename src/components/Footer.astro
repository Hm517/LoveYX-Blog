---
/** Footer.astro — site footer */
const currentYear = new Date().getFullYear();
---

<footer class="mt-20">
  <div class="h-px w-full"
       style="background: linear-gradient(90deg, transparent 0%, var(--color-border) 20%, var(--color-accent) 50%, var(--color-border) 80%, transparent 100%);"></div>
  <div class="max-w-6xl mx-auto px-5 py-10">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-5">
      <div class="flex items-center gap-3">
        <span class="w-6 h-6 rounded-md flex items-center justify-center text-[10px] font-bold text-white"
              style="background: linear-gradient(135deg, var(--color-accent), #6366f1);">L</span>
        <p class="text-sm" style="color: var(--color-muted)">&copy; {currentYear} LoveYX</p>
      </div>
      <div class="flex items-center gap-5">
        <a href="/blog" class="text-sm transition-colors hover:text-accent hover:no-underline" style="color: var(--color-muted)">博客</a>
        <a href="/archive" class="text-sm transition-colors hover:text-accent hover:no-underline" style="color: var(--color-muted)">归档</a>
        <a href="/tags" class="text-sm transition-colors hover:text-accent hover:no-underline" style="color: var(--color-muted)">标签</a>
        <a href="/about" class="text-sm transition-colors hover:text-accent hover:no-underline" style="color: var(--color-muted)">关于</a>
      </div>
      <div class="flex items-center gap-2">
        <a href="https://www.instagram.com/yinezeri/" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="Instagram">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="5"/><circle cx="17.5" cy="6.5" r="1.5"/></svg>
        </a>
        <a href="https://x.com/xiaoniaoh" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="X (Twitter)">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4l6.5 7.5L4 20h2l5.5-7 5 7H22l-7-8.5L20 4h-2l-5 6.5L9 4H4z"/></svg>
        </a>
        <a href="https://www.facebook.com/share/1BdMjhiSPG/" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="Facebook">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg>
        </a>
        <a href="https://www.tiktok.com/@kwbfcyfxu5" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="TikTok">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12a4 4 0 104 4V4h4a5 5 0 01-4 4v4z"/></svg>
        </a>
        <a href="https://github.com/Hm517/loveyx-blog" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="GitHub">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 00-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0020 4.77 5.07 5.07 0 0019.91 1S18.73.65 15 2.48a13.38 13.38 0 00-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 005 4.77a5.44 5.44 0 00-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 009 18.13V22"/></svg>
        </a>
      </div>
    </div>
    <div class="mt-5 pt-5 flex flex-col sm:flex-row items-center justify-center gap-1.5 text-xs border-t border-[var(--color-border)]" style="color: var(--color-muted)">
      <span>Powered by Astro</span><span class="hidden sm:inline">&middot;</span><span>Hosted on Cloudflare Pages</span>
    </div>
  </div>
</footer>

<style>
  .social-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 10px;
    padding: 6px;
    transition: all 0.2s;
    color: var(--color-muted, #999);
  }
  .social-icon:hover {
    color: var(--color-accent, #f8a5c2);
    transform: translateY(-2px);
  }
</style>
