---
/** Footer.astro — site footer */
const currentYear = new Date().getFullYear();
---

<footer class="mt-20">
  <div class="h-px w-full"
       style="background: linear-gradient(90deg, transparent 0%, var(--color-border) 20%, var(--color-accent) 50%, var(--color-border) 80%, transparent 100%);"></div>
  <div class="max-w-6xl mx-auto px-5 py-10">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-5">
      <div class="flex items-center gap-3">
        <span class="w-6 h-6 rounded-md flex items-center justify-center text-[10px] font-bold text-white"
              style="background: linear-gradient(135deg, var(--color-accent), #6366f1);">L</span>
        <p class="text-sm" style="color: var(--color-muted)">&copy; {currentYear} LoveYX</p>
      </div>
      <div class="flex items-center gap-5">
        <a href="/blog" class="text-sm transition-colors hover:text-accent hover:no-underline" style="color: var(--color-muted)">博客</a>
        <a href="/archive" class="text-sm transition-colors hover:text-accent hover:no-underline" style="color: var(--color-muted)">归档</a>
        <a href="/tags" class="text-sm transition-colors hover:text-accent hover:no-underline" style="color: var(--color-muted)">标签</a>
        <a href="/about" class="text-sm transition-colors hover:text-accent hover:no-underline" style="color: var(--color-muted)">关于</a>
      </div>
      <div class="flex items-center gap-3">
        <a href="#" class="p-2 rounded-lg transition-opacity duration-200 hover:opacity-70" style="color: var(--color-muted)" aria-label="Instagram">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
        </a>
        <a href="#" class="p-2 rounded-lg transition-opacity duration-200 hover:opacity-70" style="color: var(--color-muted)" aria-label="X (Twitter)">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
        <a href="#" class="p-2 rounded-lg transition-opacity duration-200 hover:opacity-70" style="color: var(--color-muted)" aria-label="Facebook">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        </a>
        <a href="#" class="p-2 rounded-lg transition-opacity duration-200 hover:opacity-70" style="color: var(--color-muted)" aria-label="LINE">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.631-.285-.631-.629V8.108c0-.345.286-.63.631-.63h2.386c.349 0 .63.285.63.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 2.385c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63.349 0 .631.285.631.63v4.14zM12.6 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H10.845v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629H10.224c-.345 0-.631-.285-.631-.629V8.108c0-.345.286-.63.631-.63H12.6c.349 0 .63.285.63.63 0 .349-.281.63-.63.63H10.845v1.125H12.6zM6.72 8.108v4.141c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V9.33L4.03 12.213c-.18.253-.52.3-.78.139-.12-.077-.21-.19-.27-.32-.054-.112-.07-.233-.07-.346V8.108c0-.345.285-.63.63-.63.349 0 .631.285.631.63v2.919l1.432-2.753c.12-.231.377-.373.648-.339.163.02.31.093.419.223.09.11.15.237.15.37zM24 5.85v12.3c0 1.958-1.587 3.545-3.545 3.545H3.545A3.544 3.544 0 010 18.15V5.85C0 3.892 1.587 2.305 3.545 2.305h16.91C22.413 2.305 24 3.892 24 5.85z"/></svg>
        </a>
        <a href="#" class="p-2 rounded-lg transition-opacity duration-200 hover:opacity-70" style="color: var(--color-muted)" aria-label="TikTok">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
        </a>
        <a href="/rss.xml" class="p-2 rounded-lg transition-opacity duration-200 hover:opacity-70" style="color: var(--color-muted)" aria-label="RSS">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1Z"/></svg>
        </a>
        <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="p-2 rounded-lg transition-opacity duration-200 hover:opacity-70" style="color: var(--color-muted)" aria-label="GitHub">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"/></svg>
        </a>
      </div>
    </div>
    <div class="mt-5 pt-5 flex flex-col sm:flex-row items-center justify-center gap-1.5 text-xs border-t border-[var(--color-border)]" style="color: var(--color-muted)">
      <span>Powered by Astro</span><span class="hidden sm:inline">&middot;</span><span>Hosted on Cloudflare Pages</span>
    </div>
  </div>
</footer>
