---
/** Footer.astro — 网站底部信息栏
 *  版权声明 | RSS 链接
 */
const currentYear = new Date().getFullYear();
---

<footer class="mt-20">
  <!-- 顶部装饰线 -->
  <div class="h-px w-full"
       style="background: linear-gradient(90deg,
         transparent 0%,
         var(--color-border) 20%,
         var(--color-accent) 50%,
         var(--color-border) 80%,
         transparent 100%);">
  </div>

  <div class="max-w-6xl mx-auto px-6 py-10">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-6">
      <!-- Brand -->
      <div class="flex items-center gap-3">
        <span class="w-7 h-7 rounded-md flex items-center justify-center text-xs font-bold text-white"
              style="background: linear-gradient(135deg, var(--color-accent), #7c3aed);">
          L
        </span>
        <p class="text-sm" style="color: var(--color-muted)">
          &copy; {currentYear} LoveYX
        </p>
      </div>

      <!-- Links -->
      <div class="flex items-center gap-6">
        <a href="/blog" class="text-sm transition-colors hover:text-accent"
           style="color: var(--color-muted)">
          博客
        </a>
        <a href="/archive" class="text-sm transition-colors hover:text-accent"
           style="color: var(--color-muted)">
          归档
        </a>
        <a href="/tags" class="text-sm transition-colors hover:text-accent"
           style="color: var(--color-muted)">
          标签
        </a>
        <a href="/about" class="text-sm transition-colors hover:text-accent"
           style="color: var(--color-muted)">
          关于
        </a>
      </div>

      <!-- Social -->
      <div class="flex items-center gap-4">
        <!-- RSS -->
        <a href="/rss.xml"
           class="p-2 rounded-lg transition-all duration-200 hover:scale-110"
           style="color: var(--color-muted)"
           aria-label="RSS 订阅">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1Z"/>
          </svg>
        </a>

        <!-- GitHub -->
        <a href="https://github.com"
           target="_blank" rel="noopener noreferrer"
           class="p-2 rounded-lg transition-all duration-200 hover:scale-110"
           style="color: var(--color-muted)"
           aria-label="GitHub">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-6 pt-6 flex flex-col sm:flex-row items-center justify-center gap-2 text-xs"
         style="color: var(--color-muted); border-top: 1px solid var(--color-border);">
      <span>Powered by Astro</span>
      <span class="hidden sm:inline">&middot;</span>
      <span>Hosted on Cloudflare Pages</span>
    </div>
  </div>
</footer>
