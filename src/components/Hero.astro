---
/** Hero.astro — 首页英雄区
 *  渐变背景 + 装饰元素 + 大标题 + 副标题 + CTA 按钮
 */
---

<section class="relative min-h-[85vh] flex items-center justify-center px-6 pt-20 overflow-hidden">
  <!-- 装饰性背景 -->
  <div class="absolute inset-0 -z-10">
    <!-- 主渐变光晕 -->
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2
                w-[600px] h-[600px] rounded-full
                bg-gradient-to-r from-accent/10 via-purple-500/5 to-pink-500/10
                blur-3xl animate-glow"></div>
    <!-- 次级光晕 -->
    <div class="absolute bottom-1/4 right-1/4
                w-[400px] h-[400px] rounded-full
                bg-accent/5 blur-3xl"
         style="animation: float 8s ease-in-out infinite;"></div>
    <!-- 网格纹理 -->
    <div class="absolute inset-0 opacity-[0.03]"
         style="background-image: radial-gradient(circle at 1px 1px, var(--color-text) 1px, transparent 0); background-size: 40px 40px;">
    </div>
  </div>

  <!-- 主内容 -->
  <div class="text-center max-w-3xl animate-hero relative">
    <!-- 标签徽章 -->
    <div class="inline-flex items-center gap-2 mb-8 px-4 py-1.5 rounded-full
                bg-accent/5 border border-accent/10 text-accent/80 text-sm font-medium
                animate-fade-up"
         style="animation-delay: 0.1s">
      <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
      Welcome to LoveYX
    </div>

    <!-- 主标题 -->
    <h1 class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl
               font-extrabold tracking-tight leading-none
               animate-fade-up"
        style="animation-delay: 0.2s">
      <span style="color: var(--color-text)">Build Something</span><br/>
      <span class="text-gradient">Interesting.</span>
    </h1>

    <!-- 副标题 -->
    <p class="mt-8 text-lg sm:text-xl leading-relaxed animate-fade-up"
       style="color: var(--color-muted); animation-delay: 0.4s; max-width: 36rem; margin-left: auto; margin-right: auto;">
      探索技术前沿，记录创造历程。<br class="hidden sm:block"/>
      在代码与文字之间，发现无限可能。
    </p>

    <!-- CTA 按钮组 -->
    <div class="mt-12 flex flex-col sm:flex-row items-center justify-center gap-4 animate-fade-up"
         style="animation-delay: 0.6s">
      <a href="/blog"
         class="btn-glow group inline-flex items-center gap-2 px-8 py-3.5 rounded-xl
                font-semibold text-sm text-white
                shadow-lg shadow-accent/20
                transition-all duration-300 hover:shadow-xl hover:shadow-accent/30
                active:scale-[0.97]"
         style="background: linear-gradient(135deg, var(--color-accent), #7c3aed);">
        查看博客
        <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-0.5"
             fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
        </svg>
      </a>
      <a href="/about"
         class="group inline-flex items-center gap-2 px-8 py-3.5 rounded-xl
                font-medium text-sm
                border transition-all duration-300
                hover:shadow-md active:scale-[0.97]"
         style="color: var(--color-muted); border-color: color-mix(in srgb, var(--color-muted) 20%, transparent);">
        了解更多
        <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-0.5"
             fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
        </svg>
      </a>
    </div>

    <!-- 统计数字 -->
    <div class="mt-16 flex items-center justify-center gap-8 sm:gap-12 animate-fade-up"
         style="animation-delay: 0.8s">
      <div class="text-center">
        <div class="text-2xl sm:text-3xl font-bold" style="color: var(--color-text)">技术</div>
        <div class="text-xs mt-1" style="color: var(--color-muted)">深度文章</div>
      </div>
      <div class="w-px h-10" style="background: var(--color-border)"></div>
      <div class="text-center">
        <div class="text-2xl sm:text-3xl font-bold" style="color: var(--color-text)">AI</div>
        <div class="text-xs mt-1" style="color: var(--color-muted)">前沿探索</div>
      </div>
      <div class="w-px h-10" style="background: var(--color-border)"></div>
      <div class="text-center">
        <div class="text-2xl sm:text-3xl font-bold" style="color: var(--color-text)">生活</div>
        <div class="text-xs mt-1" style="color: var(--color-muted)">思考记录</div>
      </div>
    </div>
  </div>

  <!-- 底部渐变过渡 -->
  <div class="absolute bottom-0 left-0 right-0 h-32 -z-10"
       style="background: linear-gradient(to top, var(--color-bg), transparent);">
  </div>
</section>
