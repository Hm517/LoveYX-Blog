---
/** BlogCard.astro — refined card with real glass hover */
export interface Props {
  title: string;
  description?: string;
  date: string;
  updated?: string;
  tags?: string[];
  category?: string;
  cover?: string;
  readingTime?: string;
  slug: string;
}

const { title, description, date, tags = [], category, cover, readingTime, slug } = Astro.props;
const displayDate = new Date(date).toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
---

<article class="group">
  <a href={`/blog/${slug}`} class="block">
    <div class="relative rounded-2xl overflow-hidden
                border border-[var(--color-border)]/70
                bg-[var(--color-surface)]/80 backdrop-blur-md
                transition-all duration-400
                hover:-translate-y-1 hover:shadow-xl hover:shadow-accent/[0.04]
                hover:border-accent/[0.15]">

      {cover && (
        <div class="aspect-[16/9] overflow-hidden relative">
          <div class="absolute inset-0 bg-[var(--color-surface)]/20 z-10"></div>
          <img src={cover} alt={title} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy"/>
          <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-surface)]/40 to-transparent z-10"></div>
        </div>
      )}

      <div class="p-5 sm:p-6">
        {category && (
          <span class="inline-flex items-center gap-1.5 mb-3 px-2.5 py-1 rounded-full text-xs font-medium
                       border transition-colors duration-300 group-hover:border-accent/20"
                style="color: var(--color-accent); background: color-mix(in srgb, var(--color-accent) 6%, transparent); border-color: color-mix(in srgb, var(--color-accent) 12%, transparent);">
            <span class="w-1 h-1 rounded-full bg-[var(--color-accent)]"></span>{category}
          </span>
        )}

        <h3 class="text-base sm:text-lg font-bold leading-snug line-clamp-2
                   transition-colors duration-300 group-hover:text-accent"
            style="color: var(--color-text)">{title}</h3>

        {description && (
          <p class="mt-2 text-sm leading-relaxed line-clamp-2" style="color: var(--color-muted)">{description}</p>
        )}

        <div class="mt-4 flex items-center gap-4 text-xs" style="color: var(--color-muted)">
          <div class="flex items-center gap-1.5">
            <svg class="w-3 h-3 opacity-50" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            <time datetime={date}>{displayDate}</time>
          </div>
          {readingTime && (
            <div class="flex items-center gap-1.5">
              <svg class="w-3 h-3 opacity-50" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              <span>{readingTime}</span>
            </div>
          )}
        </div>

        {tags.length > 0 && (
          <div class="mt-4 pt-4 flex flex-wrap gap-1.5 border-t border-[var(--color-border)]/60">
            {tags.slice(0, 3).map((tag) => (
              <span class="text-xs rounded-md px-2 py-0.5 transition-colors duration-200 group-hover:bg-accent/[0.06]"
                    style="color: var(--color-muted); background: var(--color-bg);">#{tag}</span>
            ))}
            {tags.length > 3 && <span class="text-xs rounded-md px-2 py-0.5" style="color: var(--color-muted); background: var(--color-bg);">+{tags.length - 3}</span>}
          </div>
        )}
      </div>
    </div>
  </a>
</article>
