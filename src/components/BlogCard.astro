---
/** BlogCard.astro — 博客卡片组件
 *  封面图(可选) | 分类标签 | 标题 | 日期 | 描述 | 阅读时间 | 标签
 *  接收 post frontmatter + slug props
 */

export interface Props {
  title: string;
  description?: string;
  date: string;
  updated?: string;
  tags?: string[];
  category?: string;
  cover?: string;
  readingTime?: string;
  slug: string;
}

const {
  title,
  description,
  date,
  tags = [],
  category,
  cover,
  readingTime,
  slug,
} = Astro.props;

/** 格式化日期 */
const displayDate = new Date(date).toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="group">
  <a href={`/blog/${slug}`} class="block">
    <div
      class="bg-card rounded-xl overflow-hidden border border-card hover:border-muted/20
             transition-all duration-300 hover:shadow-lg hover:-translate-y-1"
    >
      <!-- Cover Image -->
      {cover && (
        <div class="aspect-video overflow-hidden">
          <img
            src={cover}
            alt={title}
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
          />
        </div>
      )}

      <div class="p-5">
        <!-- Category Badge -->
        {category && (
          <span
            class="inline-block text-xs font-medium text-accent bg-accent/10 rounded-full px-3 py-0.5 mb-3"
          >
            {category}
          </span>
        )}

        <!-- Title -->
        <h3
          class="text-lg font-semibold text-text leading-snug group-hover:text-accent transition-colors line-clamp-2"
        >
          {title}
        </h3>

        <!-- Description -->
        {description && (
          <p class="mt-2 text-sm text-muted leading-relaxed line-clamp-2">
            {description}
          </p>
        )}

        <!-- Meta Row -->
        <div class="mt-4 flex items-center gap-3 text-xs text-muted">
          <time datetime={date}>{displayDate}</time>
          {readingTime && (
            <>
              <span>&middot;</span>
              <span>{readingTime}</span>
            </>
          )}
        </div>

        <!-- Tags -->
        {tags.length > 0 && (
          <div class="mt-3 flex flex-wrap gap-2">
            {tags.slice(0, 3).map((tag) => (
              <span class="text-xs text-muted bg-bg rounded-md px-2 py-0.5">
                #{tag}
              </span>
            ))}
            {tags.length > 3 && (
              <span class="text-xs text-muted">+{tags.length - 3}</span>
            )}
          </div>
        )}
      </div>
    </div>
  </a>
</article>
