---
/** Pagination.astro — 博客分页组件
 *  上一页/下一页 | 页码列表 | 当前页高亮
 */

export interface Props {
  currentPage: number;
  totalPages: number;
  basePath?: string;
}

const { currentPage, totalPages, basePath = '/blog' } = Astro.props;

/** 生成页码范围（带省略号） */
function getPageRange(current: number, total: number): (number | '...')[] {
  if (total <= 7) {
    return Array.from({ length: total }, (_, i) => i + 1);
  }

  const pages: (number | '...')[] = [];

  if (current <= 4) {
    for (let i = 1; i <= 5; i++) pages.push(i);
    pages.push('...', total);
  } else if (current >= total - 3) {
    pages.push(1, '...');
    for (let i = total - 4; i <= total; i++) pages.push(i);
  } else {
    pages.push(1, '...');
    for (let i = current - 1; i <= current + 1; i++) pages.push(i);
    pages.push('...', total);
  }

  return pages;
}

const pageRange = getPageRange(currentPage, totalPages);
const hasPrev = currentPage > 1;
const hasNext = currentPage < totalPages;

function pageUrl(page: number) {
  return page === 1 ? basePath : `${basePath}/page/${page}`;
}
---

{totalPages > 1 && (
  <nav class="flex items-center justify-center gap-2 mt-16" aria-label="分页导航">
    <!-- Previous -->
    {hasPrev ? (
      <a
        href={pageUrl(currentPage - 1)}
        class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl text-sm font-medium
               transition-all duration-300 hover:scale-105 hover:shadow-md hover:no-underline"
        style="color: var(--color-muted); background: var(--color-surface);
               border: 1px solid var(--color-border);"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
        </svg>
        上一页
      </a>
    ) : (
      <span
        class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl text-sm font-medium cursor-not-allowed"
        style="color: var(--color-muted); opacity: 0.3; background: var(--color-surface);
               border: 1px solid var(--color-border);"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
        </svg>
        上一页
      </span>
    )}

    <!-- Page Numbers -->
    <div class="hidden sm:flex items-center gap-1">
      {pageRange.map((item) =>
        typeof item === 'number' ? (
          <a
            href={pageUrl(item)}
            class="w-10 h-10 rounded-xl text-sm font-medium flex items-center justify-center
                   transition-all duration-300 hover:scale-105 hover:no-underline"
            style={item === currentPage
              ? `background: linear-gradient(135deg, var(--color-accent), #7c3aed); color: white; box-shadow: 0 4px 12px color-mix(in srgb, var(--color-accent) 30%, transparent);`
              : `color: var(--color-muted); background: var(--color-surface); border: 1px solid var(--color-border);`}
          >
            {item}
          </a>
        ) : (
          <span class="w-10 h-10 flex items-center justify-center text-sm select-none"
                style="color: var(--color-muted)">
            ...
          </span>
        )
      )}
    </div>

    <!-- Next -->
    {hasNext ? (
      <a
        href={pageUrl(currentPage + 1)}
        class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl text-sm font-medium
               transition-all duration-300 hover:scale-105 hover:shadow-md hover:no-underline"
        style="color: var(--color-muted); background: var(--color-surface);
               border: 1px solid var(--color-border);"
      >
        下一页
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
        </svg>
      </a>
    ) : (
      <span
        class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl text-sm font-medium cursor-not-allowed"
        style="color: var(--color-muted); opacity: 0.3; background: var(--color-surface);
               border: 1px solid var(--color-border);"
      >
        下一页
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
        </svg>
      </span>
    )}
  </nav>
)}
