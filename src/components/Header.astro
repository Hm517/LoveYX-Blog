---
/** Header.astro — 网站顶部导航栏
 *  固定顶部 | 毛玻璃背景 | 深色/浅色切换 | 移动端汉堡菜单
 */
import ThemeToggle from './ThemeToggle.astro';

const navLinks = [
  { href: '/', label: '首页' },
  { href: '/blog', label: '博客' },
  { href: '/archive', label: '归档' },
  { href: '/about', label: '关于' },
];
---

<header
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
  style="background: color-mix(in srgb, var(--color-bg) 80%, transparent);
         backdrop-filter: blur(24px) saturate(180%);
         -webkit-backdrop-filter: blur(24px) saturate(180%);
         border-bottom: 1px solid var(--color-border);"
>
  <nav class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
    <!-- Logo -->
    <a
      href="/"
      class="flex items-center gap-2 text-xl font-extrabold tracking-tight
             transition-all duration-300 hover:scale-105"
      style="color: var(--color-text)"
    >
      <span class="w-8 h-8 rounded-lg flex items-center justify-center text-sm font-bold text-white"
            style="background: linear-gradient(135deg, var(--color-accent), #7c3aed);">
        L
      </span>
      LoveYX
    </a>

    <!-- Desktop Links -->
    <div class="hidden md:flex items-center gap-1">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="relative px-4 py-2 text-sm font-medium rounded-lg
                 transition-all duration-200"
          style="color: var(--color-muted)"
        >
          {link.label}
        </a>
      ))}

      <div class="w-px h-5 mx-1" style="background: var(--color-border)"></div>

      <!-- GitHub Icon -->
      <a
        href="https://github.com"
        target="_blank"
        rel="noopener noreferrer"
        class="p-2 rounded-lg transition-all duration-200 hover:scale-110"
        style="color: var(--color-muted)"
        aria-label="GitHub"
      >
        <svg
          class="w-5 h-5"
          fill="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            fill-rule="evenodd"
            d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
            clip-rule="evenodd"
          />
        </svg>
      </a>

      <!-- Theme Toggle (Desktop) -->
      <ThemeToggle />
    </div>

    <!-- Mobile Controls -->
    <div class="flex items-center gap-3 md:hidden">
      <ThemeToggle />
      <button
        id="mobile-menu-btn"
        class="p-2 rounded-lg transition-colors"
        style="color: var(--color-muted)"
        aria-label="打开菜单"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path id="menu-icon-open" stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          <path id="menu-icon-close" class="hidden" stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M6 18L18 6" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-t"
    style="background: var(--color-surface); border-color: var(--color-border);"
  >
    <div class="px-6 py-4 flex flex-col gap-1">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="text-sm font-medium rounded-lg px-3 py-2.5 transition-colors"
          style="color: var(--color-muted)"
        >
          {link.label}
        </a>
      ))}
      <a
        href="https://github.com"
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm font-medium rounded-lg px-3 py-2.5 transition-colors"
        style="color: var(--color-muted)"
      >
        GitHub
      </a>
    </div>
  </div>
</header>

<script>
  /** 移动端汉堡菜单切换 */
  const btn = document.getElementById('mobile-menu-btn')!;
  const menu = document.getElementById('mobile-menu')!;
  const iconOpen = document.getElementById('menu-icon-open')!;
  const iconClose = document.getElementById('menu-icon-close')!;

  btn.addEventListener('click', () => {
    const isOpen = !menu.classList.contains('hidden');
    if (isOpen) {
      menu.classList.add('hidden');
      iconOpen.classList.remove('hidden');
      iconClose.classList.add('hidden');
    } else {
      menu.classList.remove('hidden');
      iconOpen.classList.add('hidden');
      iconClose.classList.remove('hidden');
    }
  });
</script>
