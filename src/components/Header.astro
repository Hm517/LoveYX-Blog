---
/** Header.astro — site nav with real glass morphism */
import ThemeToggle from './ThemeToggle.astro';

const navLinks = [
  { href: '/', label: '首页' },
  { href: '/blog', label: '博客' },
  { href: '/archive', label: '归档' },
  { href: '/about', label: '关于' },
];
---

<header class="fixed top-0 left-0 right-0 z-50
               bg-[var(--color-bg)]/75 backdrop-blur-xl
               border-b border-[var(--color-border)]/60
               transition-all duration-300">
  <nav class="max-w-6xl mx-auto px-5 h-14 flex items-center justify-between">
    <a href="/"
       class="flex items-center gap-2 text-lg font-extrabold tracking-tight
              transition-opacity duration-200 hover:opacity-80 hover:no-underline"
       style="color: var(--color-text)">
      <span class="w-7 h-7 rounded-md flex items-center justify-center text-xs font-bold text-white"
            style="background: linear-gradient(135deg, var(--color-accent), #6366f1);">L</span>
      LoveYX
    </a>

    <div class="hidden md:flex items-center gap-0.5">
      {navLinks.map((link) => (
        <a href={link.href}
           class="relative px-3.5 py-2 text-sm font-medium rounded-lg
                  transition-colors duration-200 hover:text-[var(--color-text)]"
           style="color: var(--color-muted)">{link.label}</a>
      ))}
      <div class="w-px h-5 mx-1.5 bg-[var(--color-border)]"></div>
      <a href="https://github.com" target="_blank" rel="noopener noreferrer"
         class="p-2 rounded-lg transition-opacity duration-200 hover:opacity-70"
         style="color: var(--color-muted)" aria-label="GitHub">
        <svg class="w-4.5 h-4.5" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"/></svg>
      </a>
      <ThemeToggle />
    </div>

    <div class="flex items-center gap-2 md:hidden">
      <ThemeToggle />
      <button id="mobile-menu-btn" class="p-2 rounded-lg" style="color: var(--color-muted)" aria-label="菜单">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path id="menu-icon-open" stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
          <path id="menu-icon-close" class="hidden" stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M6 18L18 6"/>
        </svg>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="hidden md:hidden border-t border-[var(--color-border)]/60 bg-[var(--color-bg)]/90 backdrop-blur-xl">
    <div class="px-5 py-3 flex flex-col gap-0.5">
      {navLinks.map((link) => (
        <a href={link.href} class="text-sm font-medium rounded-lg px-3 py-2.5" style="color: var(--color-muted)">{link.label}</a>
      ))}
      <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="text-sm font-medium rounded-lg px-3 py-2.5" style="color: var(--color-muted)">GitHub</a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn')!;
  const menu = document.getElementById('mobile-menu')!;
  const o = document.getElementById('menu-icon-open')!;
  const c = document.getElementById('menu-icon-close')!;
  btn.addEventListener('click', () => {
    const open = !menu.classList.contains('hidden');
    menu.classList.toggle('hidden');
    o.classList.toggle('hidden', open);
    c.classList.toggle('hidden', !open);
  });
</script>
