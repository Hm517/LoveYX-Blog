---
/** BlogList.astro — blog grid list */
import BlogCard from './BlogCard.astro';

interface PostItem {
  title: string;
  description?: string;
  date: string;
  updated?: string;
  tags?: string[];
  category?: string;
  cover?: string;
  readingTime?: string;
  slug: string;
}

export interface Props { posts: PostItem[]; }
const { posts } = Astro.props;
---

{posts.length > 0 ? (
  <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {posts.map((post) => (<BlogCard {...post} />))}
  </div>
) : (
  <div class="text-center py-20"><p class="text-muted text-base">暂无文章</p></div>
)}
