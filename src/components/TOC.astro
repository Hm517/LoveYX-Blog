---
/** TOC.astro — 文章目录组件
 *  接收 headings 数组 | 层级缩进 | IntersectionObserver 滚动高亮
 */

interface Heading {
  depth: number;
  text: string;
  slug: string;
}

export interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;

/** 过滤仅保留 h2/h3 */
const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{tocHeadings.length > 0 && (
  <nav class="hidden xl:block sticky top-24 w-full max-w-[220px] ml-8">
    <h4 class="text-xs font-semibold text-muted uppercase tracking-wider mb-4">
      目录
    </h4>
    <ul class="space-y-1.5 text-sm border-l border-muted/20 pl-4" id="toc-list">
      {tocHeadings.map((h) => (
        <li>
          <a
            href={`#${h.slug}`}
            data-toc-slug={h.slug}
            class="block text-muted hover:text-text transition-colors py-0.5 truncate"
            style={`padding-left: ${(h.depth - 2) * 12}px`}
          >
            {h.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<script>
  /** IntersectionObserver 高亮当前可见章节 */
  if (typeof window !== 'undefined') {
    const tocLinks = document.querySelectorAll<HTMLAnchorElement>('[data-toc-slug]');

    if (tocLinks.length > 0) {
      const headingIds = Array.from(tocLinks).map((a) => a.dataset.tocSlug!);
      const headingElements = headingIds
        .map((id) => document.getElementById(id))
        .filter(Boolean) as HTMLElement[];

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            const link = document.querySelector(`[data-toc-slug="${entry.target.id}"]`);
            if (link) {
              link.classList.toggle('text-accent', entry.isIntersecting);
              link.classList.toggle('text-muted', !entry.isIntersecting);
            }
          });
        },
        { rootMargin: '-80px 0px -70% 0px', threshold: 0 }
      );

      headingElements.forEach((el) => observer.observe(el));
    }
  }
</script>
