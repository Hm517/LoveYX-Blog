---
/** ThemeToggle.astro — dark/light mode toggle */
---
<button id="theme-toggle" type="button"
        class="relative p-2 rounded-lg transition-colors duration-300"
        style="color: var(--color-muted)" aria-label="切换主题">
  <svg class="w-4.5 h-4.5" id="sun-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
  </svg>
  <svg class="w-4.5 h-4.5 hidden" id="moon-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
  </svg>
</button>

<script>
  const toggle = document.getElementById('theme-toggle')!;
  const sun = document.getElementById('sun-icon')!;
  const moon = document.getElementById('moon-icon')!;
  const html = document.documentElement;

  function applyTheme(isLight: boolean) {
    html.classList.toggle('light', isLight);
    sun.classList.toggle('hidden', !isLight);
    moon.classList.toggle('hidden', isLight);
    localStorage.setItem('theme', isLight ? 'light' : 'dark');
  }

  const saved = localStorage.getItem('theme');
  const prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
  const isLight = saved ? saved === 'light' : prefersLight;
  applyTheme(isLight);

  toggle.addEventListener('click', () => {
    const nextLight = !html.classList.contains('light');
    applyTheme(nextLight);
  });
</script>
