---
/** categories/[category].astro — posts by category */
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogList from '../../components/BlogList.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const catSet = new Set<string>();
  posts.filter((p) => !p.data.draft).forEach((p) => { if (p.data.category) catSet.add(p.data.category); });
  return Array.from(catSet).map((category) => ({ params: { category }, props: {} }));
}

const { category } = Astro.params;
const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft && p.data.category === category)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const postItems = posts.map((p) => ({
  title: p.data.title, description: p.data.description, date: p.data.date.toISOString(),
  tags: p.data.tags, category: p.data.category, cover: p.data.cover,
  readingTime: p.data.readingTime, slug: p.slug,
}));
---

<BaseLayout title={`分类: ${category}`} description={`查看分类为「${category}」的所有文章。`}>
  <div class="max-w-6xl mx-auto px-5 pt-12 pb-20">
    <header class="mb-12 animate-fade-up">
      <div class="flex items-center gap-3 mb-3">
        <span class="w-8 h-8 rounded-lg flex items-center justify-center"
              style="background: color-mix(in srgb, var(--color-accent) 12%, transparent);">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="color: var(--color-accent)"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12.75V12A2.25 2.25 0 014.5 9.75h15A2.25 2.25 0 0121.75 12v.75m-8.69-6.44l-2.12-2.12a1.5 1.5 0 00-1.061-.44H4.5A2.25 2.25 0 002.25 6v12a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9a2.25 2.25 0 00-2.25-2.25h-5.379a1.5 1.5 0 01-1.06-.44z"/></svg>
        </span>
        <h1 class="text-2xl font-bold" style="color: var(--color-text)">
          分类: <span style="color: var(--color-accent)">{category}</span>
        </h1>
      </div>
      <p class="text-sm ml-11" style="color: var(--color-muted)">共 {posts.length} 篇文章</p>
      <div class="mt-5 ml-11">
        <a href="/categories" class="text-sm transition-colors hover:text-accent hover:no-underline" style="color: var(--color-muted)">&larr; 所有分类</a>
      </div>
    </header>
    <BlogList posts={postItems} />
  </div>
</BaseLayout>
