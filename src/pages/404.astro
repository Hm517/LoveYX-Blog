---
// 404.astro — 404 页面
// "404 - 页面不存在" + "返回首页" 按钮
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="404 - 页面不存在">
  <main class="flex-1 flex items-center justify-center px-6 pt-20">
    <div class="text-center max-w-md">
      <p class="text-8xl font-extrabold text-accent/30 select-none">404</p>
      <h1 class="text-2xl font-bold text-text mt-6 mb-3">页面不存在</h1>
      <p class="text-muted mb-8">
        你访问的页面可能已被删除、移动或从未存在过。
      </p>
      <a
        href="/"
        class="inline-flex items-center px-6 py-3 rounded-lg bg-accent text-white font-medium text-sm transition-all hover:bg-blue-400 hover:shadow-lg hover:shadow-accent/25 active:scale-95"
      >
        返回首页
      </a>
    </div>
  </main>
</BaseLayout>
