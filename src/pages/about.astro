---
/** about.astro — about page */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="关于" description="关于 LoveYX 博客和作者。">
  <div class="max-w-3xl mx-auto px-5 pt-12 pb-20 animate-fade-up">
    <header class="mb-12">
      <div class="flex items-center gap-3 mb-3">
        <span class="w-8 h-8 rounded-lg flex items-center justify-center"
              style="background: color-mix(in srgb, var(--color-accent) 12%, transparent);">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="color: var(--color-accent)"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/></svg>
        </span>
        <h1 class="text-2xl font-bold" style="color: var(--color-text)">关于</h1>
      </div>
    </header>

    <div class="space-y-8 leading-relaxed" style="color: var(--color-muted)">
      <p>
        欢迎来到 <span class="text-gradient font-semibold">LoveYX</span>，这是一个关于技术、创造和探索的个人博客。
      </p>
      <p>
        在这里，我会记录编程实践、AI 探索以及日常思考。
        代码是表达创造力的语言，而文字是沉淀思想的方式。
      </p>

      <h2 class="text-xl font-bold mt-12 mb-4" style="color: var(--color-text)">技术栈 &amp; 兴趣</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
        {['TypeScript', 'Python', 'Astro', 'React', 'Tailwind CSS', 'Node.js', 'AI/LLM', 'Cloudflare', 'DevOps'].map((item) => (
          <div class="rounded-xl px-4 py-3 text-sm font-medium text-center border transition-all duration-300 hover:-translate-y-0.5 hover:shadow-sm"
               style="color: var(--color-text); background: var(--color-surface); border-color: var(--color-border);">{item}</div>
        ))}
      </div>

      <h2 class="text-xl font-bold mt-12 mb-4" style="color: var(--color-text)">联系方式</h2>
      <div class="flex gap-4">
        <a href="https://github.com" target="_blank" rel="noopener noreferrer"
           class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-medium border transition-all duration-300
                  hover:-translate-y-0.5 hover:shadow-md hover:no-underline"
           style="color: var(--color-text); background: var(--color-surface); border-color: var(--color-border);">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"/></svg>
          GitHub
        </a>
        <a href="/rss.xml"
           class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-medium border transition-all duration-300
                  hover:-translate-y-0.5 hover:shadow-md hover:no-underline"
           style="color: var(--color-text); background: var(--color-surface); border-color: var(--color-border);">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1Z"/></svg>
          RSS
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
