---
// about.astro — 关于页
// 头像占位、昵称 LoveYX、简介、GitHub 链接、Email 链接，简洁布局
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout
  title="关于"
  canonicalURL={new URL("/about/", Astro.site).href}
>
  <main class="flex-1 pt-24 pb-12">
    <div class="max-w-2xl mx-auto px-6 text-center">
      <!-- 头像占位 -->
      <div class="w-28 h-28 mx-auto rounded-full bg-card border-2 border-muted/20 flex items-center justify-center mb-8">
        <svg
          class="w-14 h-14 text-muted"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"
          />
        </svg>
      </div>

      <!-- 昵称 -->
      <h1 class="text-3xl font-bold text-text mb-4">LoveYX</h1>

      <!-- 简介 -->
      <p class="text-muted leading-relaxed max-w-md mx-auto mb-8">
        热爱技术，热爱生活。在这里记录编程、AI 探索与日常思考。
        Build something interesting, share every creation.
      </p>

      <!-- 社交链接 -->
      <div class="flex items-center justify-center gap-6">
        <a
          href="https://github.com"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-card text-muted hover:text-text border border-card hover:border-muted/20 transition-all"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path
              fill-rule="evenodd"
              d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
              clip-rule="evenodd"
            />
          </svg>
          GitHub
        </a>

        <a
          href="mailto:loveyx@loveyx.fun"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-card text-muted hover:text-text border border-card hover:border-muted/20 transition-all"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
          </svg>
          Email
        </a>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
